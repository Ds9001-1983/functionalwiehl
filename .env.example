# Env-Vorlage für functional-wiehl.de – nur Namen, NIE Werte eintragen.
# Lokal: Kopie als .env.local (gitignored). Vercel: Production und Preview im Dashboard.
# Die Playwright-Abnahme setzt ihre Testwerte selbst (playwright.config.ts), .env.local spielt dort keine Rolle.

# ── Build ─────────────────────────────────────────────────────────────
# "true" nur in Production auf functional-wiehl.de, sonst noindex
NEXT_PUBLIC_ALLOW_INDEXING=
# z. B. https://functional-wiehl.de
NEXT_PUBLIC_SITE_URL=

# ── Upstash Redis (Vercel Marketplace, Frankfurt) ──────────────────────
KV_REST_API_URL=
KV_REST_API_TOKEN=

# ── Black November: Klickspeicher /wp-json/sb-bn/v1/click ──────────────
# Basic Auth wie das n8n-Credential (WP-App-Passwort, Leerzeichen erlaubt)
BN_CLICK_USER=
BN_CLICK_PASS=
# Löschdatum der Klickdaten, Format 2026-12-10T00:00:00+01:00
BN_CLICK_DELETE_AT=
# nur lokal/Tests: "memory" (auf Vercel gesperrt)
BN_CLICK_STORE=

# ── Rate-Limit (HMAC der IP) ──────────────────────────────────────────
RATE_LIMIT_SECRET=
# optional, Standard 5 Anfragen je 10 Minuten
FORM_RATE_LIMIT=

# ── Mail (Alfahosting-SMTP, Postfach gym@) ──────────────────────────────
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
FORM_TO=
ALERT_TO=
# nur Tests: "json" (Mails landen in der Testsenke, auf Vercel gesperrt)
MAIL_TRANSPORT=

# ── Später: Instagram-Feed ─────────────────────────────────────────────
CRON_SECRET=
INSTAGRAM_TOKEN=
BLOB_READ_WRITE_TOKEN=
IG_BLOB_HOST=
